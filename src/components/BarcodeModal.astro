---
import { BARCODE_FORMATS } from '../lib/barcode';
---

<!-- Full-screen barcode popout -->
<div class="barcode-fullscreen" id="barcode-modal">
  <button class="barcode-fullscreen-close" id="barcode-modal-close">&times;</button>

  <div class="barcode-fullscreen-body" id="barcode-view">
    <div class="barcode-card-frame">
      <div class="barcode-card-header" id="barcode-card-header">
        <img id="barcode-logo" class="barcode-header-logo" alt="" style="display:none" />
        <span id="barcode-store-name"></span>
      </div>
      <div class="barcode-card-body">
        <div class="barcode-fullscreen-render" id="barcode-render-area"></div>
      </div>
    </div>
    <img class="barcode-fullscreen-photo" id="barcode-photo" alt="Card photo" style="display:none" />
  </div>

  <!-- Edit mode -->
  <div id="barcode-edit" class="edit-form">
    <div class="modal-header">
      <h2>Edit Card</h2>
      <button class="modal-close" id="edit-cancel-btn">&times;</button>
    </div>
    <div class="modal-body">
      <form id="edit-card-form">
        <input type="hidden" id="edit-card-id" />
        <div class="form-group">
          <label for="edit-store-name">Store Name</label>
          <input type="text" id="edit-store-name" required />
        </div>
        <div class="form-group">
          <label for="edit-barcode-data">Barcode Data</label>
          <input type="text" id="edit-barcode-data" required />
        </div>
        <div class="form-group">
          <label for="edit-format">Format</label>
          <select id="edit-format">
            {BARCODE_FORMATS.map(f => (
              <option value={f.value}>{f.label}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label>Color</label>
          <div class="color-options" id="edit-color-options">
            {['#4a90d9', '#e53e3e', '#38a169', '#d69e2e', '#805ad5', '#dd6b20', '#319795', '#d53f8c', '#718096'].map(c => (
              <div class="color-swatch" data-color={c} style={`background: ${c}`}></div>
            ))}
          </div>
          <input type="hidden" id="edit-color" />
        </div>
        <div class="form-group">
          <label for="edit-notes">Notes</label>
          <textarea id="edit-notes" rows="2"></textarea>
        </div>
        <div class="form-group">
          <label for="edit-photo">Photo</label>
          <input type="file" id="edit-photo" accept="image/*" capture="environment" />
        </div>
        <div style="display: flex; gap: 0.75rem;">
          <button type="submit" class="btn btn-primary" style="flex:1">Save</button>
          <button type="button" class="btn btn-secondary" id="edit-back-btn">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Action sheet (long-press on card tiles) -->
<div class="action-sheet-overlay" id="action-sheet-overlay">
  <div class="action-sheet">
    <div class="action-sheet-title" id="action-sheet-title"></div>
    <button id="action-sheet-edit">Edit Card</button>
    <button id="action-sheet-delete">Delete Card</button>
    <button id="action-sheet-cancel">Cancel</button>
  </div>
</div>
