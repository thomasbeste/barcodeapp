---
interface Props {
  id: number;
  storeName: string;
  barcodeData: string;
  format: string;
  color?: string | null;
}

const { id, storeName, barcodeData, format, color } = Astro.props;
const stripeColor = color || '#4a90d9';
---

<div class="card-flip-container" data-card-id={id} data-barcode={barcodeData} data-format={format} role="button" tabindex="0">
  <div class="card-tile">
    <div class="card-tile-front">
      <div class="card-tile-stripe" style={`background: ${stripeColor}`}></div>
      <div class="card-tile-body">
        <div class="card-tile-name">{storeName}</div>
        <div class="card-tile-format">{format}</div>
      </div>
    </div>
    <div class="card-tile-back">
      <div class="barcode-target"></div>
      <div class="back-label">{storeName}</div>
    </div>
  </div>
</div>
